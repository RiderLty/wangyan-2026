# 复制为 .env 后按需修改：cp .env.example .env
# 开发环境默认连接 NAS 数据库容器（部署命令见 nas-db-setup.sh）

# PostgreSQL（NAS 容器，宿主机端口 15432；5432 已被 NAS 原生服务占用）
POSTGRES_HOST=192.168.3.3
POSTGRES_PORT=15432
POSTGRES_USER=note
POSTGRES_PASSWORD=change-me
POSTGRES_DB=markdown_notes

# Redis（NAS 容器，宿主机端口 16379）
REDIS_HOST=192.168.3.3
REDIS_PORT=16379
REDIS_PASSWORD=change-me

# 后端（3000 在 NAS 上被占用，统一用 13000）
NODE_ENV=development
SERVER_PORT=13000
JWT_SECRET=change-me-before-defense
JWT_EXPIRES_IN=7d

# 前端（生产容器对外端口）
WEB_PORT=18080

# ---- AI 智能辅助（v2.0，服务端全托管：用户零配置，Key 只存本文件，前端永不接触）----
# 对话通道：OpenAI 兼容端点，默认 DeepSeek（决策 D-015）
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-flash
# 可选：编辑器续写等低延迟场景的快速模型（留空则用 AI_MODEL）
AI_MODEL_FAST=
# 向量通道（可选，L3 语义检索开关）：任意 OpenAI 兼容 /v1/embeddings 服务，
# 默认规划为阿里百炼 qwen3.7-text-embedding；留空则 L3 功能隐藏，不影响其他 AI 功能
AI_EMBEDDINGS_BASE_URL=
AI_EMBEDDINGS_API_KEY=
AI_EMBEDDINGS_MODEL=
