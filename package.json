{
  "name": "wangyan-2026",
  "private": true,
  "description": "在线Markdown笔记编辑与管理平台（毕业论文配套系统）",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @app/web dev",
    "dev:server": "pnpm --filter @app/server start:dev",
    "build": "pnpm -r build",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose stop postgres redis",
    "up": "docker compose up -d --build",
    "down": "docker compose down"
  },
  "devDependencies": {
    "mermaid": "^12.0.0",
    "puppeteer-core": "^25.11.0",
    "typescript": "^5.6.0"
  }
}
